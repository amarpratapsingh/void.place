{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "void-place-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SECTOR_ROOMS",
        "class_name": "SectorRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["SectorRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "void-place-tiles"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "void-place-db",
      "database_id": "local-void-place-db"
    }
  ]
}
